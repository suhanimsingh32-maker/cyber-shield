# CyberShield Environment Variables
# Copy this file to .env for local deployment

# ---- Frontend Client Public Variables (Exposed to Browser) ----
VITE_SUPABASE_URL=your-supabase-url
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# ---- Server-Side Privileged Variables (SERVER ONLY) ----
SUPABASE_URL=your-supabase-url
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ---- Threat Intelligence APIs (OPTIONAL) ----
# Leave blank to run on local heuristic detection only.
GOOGLE_SAFE_BROWSING_API_KEY=
VIRUSTOTAL_API_KEY=

# ---- Detection Mode ----
DETECTION_MODE=local

# ---- Web Server ----
PORT=3000